# Copy to .env and adjust. docker compose reads this file automatically.
# Every value has a working development default, so .env is optional locally.

# --- Required for production -----------------------------------------------------------
# "production" refuses to start with the default SECRET_KEY.
ENVIRONMENT=development
# Signs login tokens. Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
# Public address of the web app; used in invitation links and email images.
PUBLIC_APP_URL=http://localhost:8080
# Domain Caddy requests an HTTPS certificate for (only with `--profile tls`).
DOMAIN=weddings.example.com

# --- Database --------------------------------------------------------------------------
POSTGRES_USER=wedding
POSTGRES_PASSWORD=wedding
POSTGRES_DB=wedding

# --- Email -----------------------------------------------------------------------------
# The defaults deliver to the development Mailpit inbox (http://localhost:8025, `make up`).
# In production point these at your email provider.
# EMAIL_BACKEND: smtp | console | file
EMAIL_BACKEND=smtp
EMAIL_FROM="Wedding Planner <invitations@example.com>"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false

# --- Server ------------------------------------------------------------------------------
# API processes. Roughly 2 x CPU cores is a good starting point.
WEB_CONCURRENCY=2
# Host port for the web app. Behind Caddy, use WEB_BIND=127.0.0.1 to keep it private.
WEB_BIND=0.0.0.0
WEB_PORT=8080
MAILPIT_PORT=8025

# --- Abuse limits (optional) -------------------------------------------------------------
# Counted per client address in each API process; 0 switches a limit off.
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_PUBLIC_PER_MINUTE=60
# RATE_LIMIT_EMAIL_PER_HOUR=30
# How long invitation and password reset links stay valid.
# INVITE_EXPIRE_DAYS=7
# PASSWORD_RESET_EXPIRE_MINUTES=60
